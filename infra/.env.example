# Copy to .env at repo root. Never commit .env.

# LLM backend: "cache" (default, free, replays backend/llm_cache/) or "live"
LLM_MODE=cache

# Live mode, option A: Azure AI Foundry (Azure free credit)
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_DEPLOYMENT=

# Live mode, option B: GitHub Models free tier
GITHUB_TOKEN=

# Match replay (MATCH_ID from data/source/; empty = first match found)
MATCH_ID=
REPLAY_SPEED=15
